# Web process
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_BASE_URL=http://127.0.0.1:3000
ADMIN_PASSWORD=replace-with-a-long-dashboard-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Hostinger MySQL database (copy these values from hPanel)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_username
DB_PASSWORD=your_database_password

# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Spotify Developer Dashboard
SPOTIFY_CLIENT_ID=your-client-id
SPOTIFY_CLIENT_SECRET=your-client-secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/spotify/callback

# Poll worker
POLL_INTERVAL_MINUTES=10
POLL_BATCH_SIZE=20
SCHEDULER_INTERVAL_SECONDS=5
